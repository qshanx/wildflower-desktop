<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/outside.ico</ApplicationIcon>
    <Product>窗外</Product>
    <AssemblyName>WildflowerDesktop</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/outside.ico" LogicalName="WildflowerDesktop.Assets.outside.ico" />
    <EmbeddedResource Include="Assets/pond-cover.jpg" LogicalName="WildflowerDesktop.Assets.pond-cover.jpg" />
    <EmbeddedResource Include="Assets/rain-cover.jpg" LogicalName="WildflowerDesktop.Assets.rain-cover.jpg" />
    <EmbeddedResource Include="Assets/pink-cover.jpg" LogicalName="WildflowerDesktop.Assets.pink-cover.jpg" />
    <Content Include="../../themes/rain-window/**" Link="themes/rain-window/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Content Include="../../themes/pond-garden/**" Link="themes/pond-garden/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
